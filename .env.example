# Copy to .env and fill in. The Arango values come from your deployment's credentials.
ARANGO_HOST=https://your-deployment.arango.ai
ARANGO_DB=incident_demo
ARANGO_USER=arango_username
ARANGO_PASSWORD=your-password
OPENAI_API_KEY=sk-...

# GraphRAG knowledge graph. The runbook KG is built by AutoGraph; its collections live in the
# same database as the multimodel core (incident_demo) under the AutoGraph project name. Create
# the AutoGraph project once via the UI wizard (Documents -> Configure -> Build), which deploys
# the AutoGraph service and builds the Corpus Graph; then Generate strategies and Continue to
# build for the Knowledge Graph. The import and corpus steps are also scriptable via the REST
# API (graphrag_ingest.py); service postfixes are discovered at runtime in graphrag.py.
GRAPHRAG_DB=incident_demo
GRAPHRAG_PROJECT=incidents-runbook-autograph